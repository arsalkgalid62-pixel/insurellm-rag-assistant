# Required — OpenAI for embeddings and default chat/ingest models
OPENAI_API_KEY=sk-your-key-here

# Optional — use Groq or other LiteLLM providers (prefix model with provider)
# GROQ_API_KEY=gsk_...
# CHAT_MODEL=groq/llama-3.3-70b-versatile

# Model overrides (LiteLLM format: provider/model)
CHAT_MODEL=openai/gpt-4.1-mini
INGEST_MODEL=openai/gpt-4.1-nano
EMBEDDING_MODEL=text-embedding-3-large

# Retrieval tuning
RETRIEVAL_K=20
FINAL_K=10
INGEST_WORKERS=3
